# =====================================================================
#  MCP-INDUSTRIAL-NET · variables de entorno (ejemplo)
#  Copiar a .env y completar. NUNCA subir .env a git.
#
#  Backend Python (FastAPI).  Los nombres son los mismos que usaba el
#  backend ASP.NET: la sección va con "__" (Mqtt__Host -> sección Mqtt).
# =====================================================================

# ---------- red ----------
COMPOSE_PROJECT_NAME=mcp-industrial

# ---------- frontend (Nginx) ----------
FRONTEND_PORT=8080

# ---------- backend (FastAPI) ----------
# MQTT (Mosquitto en la red de aplicación)
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Agente IA: la clave vive SOLO en variables de entorno (jamás en la imagen ni en git)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Catálogo de modelos que se puede elegir en el chat: "id|Nombre,id2|Nombre2"
OPENROUTER_MODELS=
# Puerto de depuración del backend (solo loopback; opcional)
BACKEND_DEBUG_PORT=5295

# ---------- control (DRY-RUN obligatorio) ----------
# Regla de seguridad: NO cambiar a Real; NO HabilitadoEscritura=true; NO CONTROL_REAL=1
# Para escribir en el PLC hacen falta los TRES interruptores a la vez:
#   1) Control__Modo=Real  2) Control__HabilitadoEscritura=true  3) CONTROL_REAL=1
#   4) el selector físico del tablero en REMOTO (lo verifica el conector)
CONTROL_MODO=DryRun
CONTROL_HABILITADOESCRITURA=false
CONTROL_REAL=0
# Control de caudal (MCC-09): DryRun por defecto (antes venía armado en Real)
CONTROL_CAUDAL_MODO=DryRun
CONTROL_CAUDAL_HABILITADOESCRITURA=false
CONTROL_CAUDAL_REAL=0
# Control de presión (MCP-09)
CONTROL_PRESION_MODO=DryRun
CONTROL_PRESION_HABILITADOESCRITURA=false
CONTROL_PRESION_REAL=0
# Control de temperatura (MCT-09)
CONTROL_TEMPERATURA_MODO=DryRun
CONTROL_TEMPERATURA_HABILITADOESCRITURA=false
CONTROL_TEMPERATURA_REAL=0

# ---------- operacion degradada (TEMPORAL: sensor de nivel saturado) ----------
# El sensor ultrasonico del MCN-09 esta FUERA DE RANGO: I:1.1 = 0 V, N7:4 ~ 60 cuentas.
# El valor en cm que ve el lazo es el TOPE de la escala (~40,9 cm), NO una medida real.
# Con 1 se permiten expedir ordenes que NO dependen del PV (arranque, parada, valvula);
# cada una queda MARCADA en la auditoria JSONL.  El setpoint en cm se rechaza
# SIEMPRE con el sensor saturado (pilotar contra un PV ficticio es peligroso).
# Ponerlo en 0 en cuanto se repare el sensor.
CONTROL_PERMITIR_SENSOR_FUERA_DE_RANGO=0

# ---------- timescaledb ----------
POSTGRES_DB=mcpindustrial
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esto
# Usuarios de aplicacion (ver deploy/postgres/init/)
INGESTOR_PASSWORD=ingestor_cambiar
BACKEND_RO_PASSWORD=lector_cambiar

# ---------- ingestor nivel ----------
INGESTOR_EQUIPO=nivel-mcn09
INGESTOR_SALUD_PUERTO=8099

# ---------- conector de control nivel ----------
# dry-run | simulador | real
CONECTOR_MODO=dry-run
CONECTOR_SALUD_PUERTO=8098
# IP del PLC solo relevante en el perfil edge / modo real
PLC_NIVEL_IP=192.168.114.9

# ---------- grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_esto

# ---------- mcp-nivel (SSE) ----------
MCP_NIVEL_PUERTO=8000

# ---------- usuarios (login) ----------
# Primer administrador: se crea SOLO si la tabla de usuarios esta vacia.
# Despues, las contraseñas se cambian desde la pantalla Usuarios (no aqui).
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambiar_esto_min_8
# Token de solo lectura para el servidor MCP y las pruebas de agentes (>=16 caracteres)
SERVICIO_TOKEN=cambiar_esto_token_largo
