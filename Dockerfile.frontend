# =====================================================================
#  Frontend: React (Node) → Nginx con proxy a /api y /hubs (SignalR/WS)
#  No incluye tokens ni secretos: la SPA solo habla con el backend vía Nginx.
# =====================================================================
FROM node:22-alpine AS build
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
LABEL org.opencontainers.image.title="mcp-industrial-frontend"
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
# healthcheck sin dependencias extra (wget de busybox)
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1 || exit 1
EXPOSE 80
