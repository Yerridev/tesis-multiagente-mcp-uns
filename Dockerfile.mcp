# =====================================================================
#  Servidor MCP del módulo de nivel (SSE) — SOLO LECTURA.
#  Expone herramientas de estado/histórico/diagnóstico/metadatos/grafo/calidad
#  contra el backend REST. Ninguna herramienta de escritura ni de control.
# =====================================================================
FROM python:3.12-slim
LABEL org.opencontainers.image.title="mcp-industrial-mcp-nivel"
RUN useradd -m -u 10001 -s /usr/sbin/nologin appuser
WORKDIR /app
COPY mcp/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY mcp/server_nivel.py mcp/grafo_nivel.json ./
USER appuser
ENV PYTHONUNBUFFERED=1 \
    MCP_NIVEL_PUERTO=8000 \
    BACKEND_URL=http://backend:8080
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/sse', timeout=3) else 1)" || exit 0
CMD ["python", "server_nivel.py"]
