    "HabilitadoEscritura": false,
    "TimeoutSegundos": 10,
    "ExpiracionSegundos": 15,
    "VentanaDuplicadosSegundos": 30,
    "TopicoBase": "uss/campus/lab-automatizacion/sl01la07/nivel-mcn09/control",
    "AuditoriaRuta": "auditoria",
    "Usuarios": {
      "dev-viewer": "viewer",
      "dev-operador": "operador",
      "dev-supervisor": "supervisor",
      "dev-admin": "admin"
    }
  },
  "ControlTemperatura": {
    "Modo": "DryRun",
    "HabilitadoEscritura": false,
    "TimeoutSegundos": 15,
    "ExpiracionSegundos": 20,
    "TopicoBase": "uss/campus/lab-automatizacion/sl01la07/temperatura-mct09/control"
  },
  "OpenRouter": {
