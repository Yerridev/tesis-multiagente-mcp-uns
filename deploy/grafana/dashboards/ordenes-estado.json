{
  "title": "Órdenes de control por estado",
  "uid": "ordenes-estado",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["mcp", "control"],
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Órdenes por estado (últimas registradas)",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT estado, count(*) AS total FROM ordenes_control GROUP BY 1 ORDER BY 2 DESC",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Órdenes emitidas en el tiempo",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT time_bucket('5 minutes', expedida) AS time, count(*) AS ordenes FROM ordenes_control WHERE expedida > now() - interval '24 hours' GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    }
  ]
}
