# Copia este archivo como .env y cambia las contrasenas antes del primer "docker compose up".
DB_NAME=uns
DB_USER=uns_admin
DB_PASSWORD=cambiar_esto
MCP_READER_PASSWORD=lector_cambiar
GRAFANA_PASSWORD=admin
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
UNS_BASE=uss/campus/lab-automatizacion/sl01la07/caudal-mcc09

# Agente del lienzo vivo (http://localhost:8765). Sin clave, el lienzo funciona sin chat.
# LLM_PROVEEDOR: openrouter (multimodelo, 1 sola clave) | gemini (gratis, clave de Google AI Studio)
#                | anthropic (API de pago) | openai (compatible: LLM_BASE_URL + LLM_API_KEY + LLM_MODELO)
# Para cambiar de proveedor o de modelo: edita estas lineas y rehecho "docker compose up -d lienzo".
LLM_PROVEEDOR=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
