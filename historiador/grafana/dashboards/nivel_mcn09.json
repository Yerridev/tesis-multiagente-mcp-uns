{
  "uid": "uns-nivel-mcn09",
  "title": "Modulo de nivel MCN-09 - UNS",
  "description": "MicroLogix 1100 (192.168.114.9). Nivel del tanque T2 calibrado: cm = (16348 - N7:4)/400. Rango de trabajo 0-35 cm (fabricante); el sensor satura cerca de 40 cm.",
  "timezone": "America/Lima",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["uns", "nivel", "tesis"],
  "templating": {
    "list": [
      {
        "name": "fuente",
        "label": "Fuente de datos",
        "type": "custom",
        "query": "uns,lvm",
        "current": { "text": "uns", "value": "uns" },
        "options": [
          { "text": "uns", "value": "uns", "selected": true },
          { "text": "lvm", "value": "lvm", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nivel T2",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
          "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor FROM mediciones WHERE variable = 'nivel-mcn09/nivel/cm' AND fuente = '$fuente' ORDER BY time DESC LIMIT 1"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "decimals": 1, "unit": "lengthcm",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null },
            { "color": "orange", "value": 35 },
            { "color": "red", "value": 40 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bomba",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
          "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor FROM mediciones WHERE variable = 'nivel-mcn09/estado/bomba_marcha' AND fuente = 'uns' ORDER BY time DESC LIMIT 1"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "mappings": [{ "type": "value", "options": {
            "1": { "text": "EN MARCHA", "color": "green", "index": 0 },
            "0": { "text": "DETENIDA", "color": "red", "index": 1 }
          } }]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Modo",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
          "rawQuery": true, "editorMode": "code", "format": "table",
          "rawSql": "SELECT now() AS \"time\", CASE WHEN (SELECT valor FROM mediciones WHERE variable = 'nivel-mcn09/estado/selector_remoto' AND fuente = 'uns' ORDER BY time DESC LIMIT 1) >= 0.5 THEN 2 WHEN (SELECT valor FROM mediciones WHERE variable = 'nivel-mcn09/estado/selector_local' AND fuente = 'uns' ORDER BY time DESC LIMIT 1) >= 0.5 THEN 1 ELSE 0 END AS modo"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^modo$/", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "mappings": [{ "type": "value", "options": {
            "2": { "text": "REMOTO", "color": "purple", "index": 0 },
            "1": { "text": "LOCAL", "color": "orange", "index": 1 },
            "0": { "text": "SELECTOR EN 0", "color": "text", "index": 2 }
          } }]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tanque T1 (reserva)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
          "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor FROM mediciones WHERE variable = 'nivel-mcn09/estado/tanque1_con_agua' AND fuente = 'uns' ORDER BY time DESC LIMIT 1"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "mappings": [{ "type": "value", "options": {
            "1": { "text": "CON AGUA", "color": "green", "index": 0 },
            "0": { "text": "NIVEL BAJO", "color": "red", "index": 1 }
          } }]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Nivel del tanque T2 (cm) - valores fuera de -2..42 cm descartados",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
          "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor AS \"Nivel T2\" FROM mediciones WHERE variable = 'nivel-mcn09/nivel/cm' AND fuente = '$fuente' AND valor BETWEEN -2 AND 42 AND $__timeFilter(time) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
          "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor AS \"Setpoint (historico)\" FROM mediciones WHERE variable = 'nivel-mcn09/pid/setpoint_cm' AND fuente = '$fuente' AND $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthcm", "min": 0, "max": 45,
          "custom": {
            "lineWidth": 2, "showPoints": "never", "spanNulls": true,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "transparent", "value": null },
            { "color": "orange", "value": 35 },
            { "color": "red", "value": 40 }
          ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Caudal neto estimado hacia T2 (L/min) = pendiente del nivel x 0,717 L/cm",
      "description": "Estimacion: T2 de 43 L en 60 cm con seccion constante. Positivo = llenando, negativo = vaciando. Promedios de 10 s.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
          "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "WITH b AS (SELECT time_bucket('10 seconds', time) AS t, avg(valor) AS v FROM mediciones WHERE variable = 'nivel-mcn09/nivel/cm' AND fuente = '$fuente' AND valor BETWEEN -2 AND 42 AND $__timeFilter(time) GROUP BY 1), d AS (SELECT t, v - lag(v) OVER (ORDER BY t) AS dv, extract(epoch FROM t - lag(t) OVER (ORDER BY t)) AS dt FROM b) SELECT t AS \"time\", dv / dt * 60 * (43.0 / 60.0) AS \"Caudal neto estimado\" FROM d WHERE dt > 0 AND dt <= 30 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "L/min", "decimals": 1, "custom": { "lineWidth": 2, "showPoints": "never", "spanNulls": false } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Velocidad de la bomba",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
          "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor AS \"Frecuencia estimada (Hz)\" FROM mediciones WHERE variable = 'nivel-mcn09/bomba/frecuencia_estimada_hz' AND fuente = '$fuente' AND $__timeFilter(time) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
          "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor AS \"Senal de control PID % (historico)\" FROM mediciones WHERE variable = 'nivel-mcn09/pid/senal_control_pct' AND fuente = '$fuente' AND $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 1, "custom": { "lineWidth": 2, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Estados (en vivo)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        { "refId": "A", "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" }, "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor AS \"Bomba\" FROM mediciones WHERE variable = 'nivel-mcn09/estado/bomba_marcha' AND fuente = 'uns' AND $__timeFilter(time) ORDER BY 1" },
        { "refId": "B", "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" }, "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor AS \"LOCAL\" FROM mediciones WHERE variable = 'nivel-mcn09/estado/selector_local' AND fuente = 'uns' AND $__timeFilter(time) ORDER BY 1" },
        { "refId": "C", "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" }, "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor AS \"REMOTO\" FROM mediciones WHERE variable = 'nivel-mcn09/estado/selector_remoto' AND fuente = 'uns' AND $__timeFilter(time) ORDER BY 1" },
        { "refId": "D", "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" }, "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor AS \"Valvula abriendo\" FROM mediciones WHERE variable = 'nivel-mcn09/valvula/abriendo' AND fuente = 'uns' AND $__timeFilter(time) ORDER BY 1" },
        { "refId": "E", "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" }, "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor AS \"T1 con agua\" FROM mediciones WHERE variable = 'nivel-mcn09/estado/tanque1_con_agua' AND fuente = 'uns' AND $__timeFilter(time) ORDER BY 1" },
        { "refId": "F", "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale-uns" }, "rawQuery": true, "editorMode": "code", "format": "time_series",
          "rawSql": "SELECT time AS \"time\", valor AS \"I:0/3 (nivel alto T1?)\" FROM mediciones WHERE variable = 'nivel-mcn09/estado/mando_i03' AND fuente = 'uns' AND $__timeFilter(time) ORDER BY 1" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#555555", "value": null }, { "color": "green", "value": 0.5 }] },
          "mappings": [{ "type": "value", "options": { "0": { "text": "OFF", "index": 0 }, "1": { "text": "ON", "index": 1 } } }],
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "never", "rowHeight": 0.8, "legend": { "showLegend": false } }
    }
  ]
}
