    {
      "id": 3,
      "type": "stat",
      "title": "Modo",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale-uns"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale-uns"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT now() AS \"time\", CASE WHEN (SELECT valor FROM mediciones WHERE variable = 'presion-mcp09/estado/selector_remoto' AND fuente = 'uns' ORDER BY time DESC LIMIT 1) >= 0.5 THEN 2 WHEN (SELECT valor FROM mediciones WHERE variable = 'presion-mcp09/estado/selector_local' AND fuente = 'uns' ORDER BY time DESC LIMIT 1) >= 0.5 THEN 1 ELSE 0 END AS modo"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^modo$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
