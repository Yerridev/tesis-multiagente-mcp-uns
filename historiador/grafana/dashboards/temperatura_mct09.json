    {
      "id": 9,
      "type": "timeseries",
      "title": "Velocidad de calentamiento del tanque principal (C/min, ventanas de 1 min)",
      "description": "Pendiente de la temperatura principal. Sirve para detectar calentamiento sin orden del PLC (rele de estado solido en falla) o resistencia sin potencia.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale-uns"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale-uns"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "WITH b AS (SELECT time_bucket('1 minute', time) AS t, avg(valor) AS v FROM mediciones WHERE variable = 'temperatura-mct09/temperatura/principal_c' AND fuente = '$fuente' AND $__timeFilter(time) GROUP BY 1), d AS (SELECT t, v - lag(v) OVER (ORDER BY t) AS dv, extract(epoch FROM t - lag(t) OVER (ORDER BY t)) AS dt FROM b) SELECT t AS \"time\", dv / dt * 60 AS \"dT/dt\" FROM d WHERE dt > 0 AND dt <= 120 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
