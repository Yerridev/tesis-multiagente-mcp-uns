      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale-uns"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT now() AS \"time\", CASE WHEN (SELECT valor FROM mediciones WHERE variable = 'temperatura-mct09/estado/selector_remoto' AND fuente = 'uns' ORDER BY time DESC LIMIT 1) >= 0.5 THEN 2 WHEN (SELECT valor FROM mediciones WHERE variable = 'temperatura-mct09/estado/selector_local' AND fuente = 'uns' ORDER BY time DESC LIMIT 1) >= 0.5 THEN 1 ELSE 0 END AS modo"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^modo$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
